generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * ============================================================
 * ENUMS
 * ============================================================
 */

enum UserRole {
  MAIN_ADMIN
  DEPOT_ADMIN
  SUPERVISOR
  OPERATIONAL_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  ON_TRIP
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VehicleType {
  SINGLE_DECKER
  DOUBLE_DECKER
  ELECTRIC_BUS
  ARTICULATED_BUS
  COACH
}

enum FuelType {
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

/**
 * ============================================================
 * DEPOT
 * ============================================================
 */

model Depot {
  id Int @id @default(autoincrement())

  depotCode String @unique @default(cuid())

  name String
  code String @unique

  address String?
  phone   String?
  email   String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users        User[]
  drivers      Driver[]
  vehicles     Vehicle[]
  routes       Route[]
  schedules    Schedule[]
  fuelLogs     FuelLog[]
  maintenances MaintenanceRecord[]

  @@map("depots")
}

/**
 * ============================================================
 * USER
 * ============================================================
 */

model User {
  id Int @id @default(autoincrement())

  userId String @unique @default(cuid())

  fullName String
  email    String @unique
  username String @unique
  password String

  role   UserRole
  status UserStatus @default(ACTIVE)

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  auditLogs AuditLog[]

  @@index([depotId])
  @@index([role])
  @@index([status])
  @@map("users")
}

/**
 * ============================================================
 * DRIVER
 * ============================================================
 */

model Driver {
  id Int @id @default(autoincrement())

  driverId String @unique @default(cuid())

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  fullName String

  nic String @unique

  phone   String
  address String?

  licenseNumber String   @unique
  licenseExpiry DateTime

  status DriverStatus @default(ACTIVE)

  schedules Schedule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([depotId])
  @@index([status])
  @@map("drivers")
}

/**
 * ============================================================
 * VEHICLE
 * ============================================================
 */

model Vehicle {
  id Int @id @default(autoincrement())

  vehicleId String @unique @default(cuid())

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  registrationNumber String @unique

  vehicleType VehicleType

  seatingCapacity Int

  mileage Float

  fuelType FuelType

  status VehicleStatus @default(AVAILABLE)

  schedules Schedule[]

  fuelLogs FuelLog[]

  maintenanceRecords MaintenanceRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([depotId])
  @@index([status])
  @@map("vehicles")
}

/**
 * ============================================================
 * ROUTE
 * ============================================================
 */

model Route {
  id Int @id @default(autoincrement())

  routeId String @unique @default(cuid())

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  routeName String

  startLocation String

  endLocation String

  distance Float @default(0)

  estimatedDuration Int @default(0)

  status RouteStatus @default(ACTIVE)

  stops RouteStop[]

  schedules Schedule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([depotId])
  @@index([status])
  @@map("routes")
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

/**
 * ============================================================
 * ROUTE STOPS
 * ============================================================
 */

model RouteStop {
  id Int @id @default(autoincrement())

  routeId Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  stopName String

  stopOrder Int

  createdAt DateTime @default(now())

  @@index([routeId])
  @@map("route_stops")
}

/**
 * ============================================================
 * SCHEDULE
 * ============================================================
 */

model Schedule {
  id Int @id @default(autoincrement())

  scheduleId String @unique @default(cuid())

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  routeId Int
  route   Route @relation(fields: [routeId], references: [id])

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  driverId Int
  driver   Driver @relation(fields: [driverId], references: [id])

  departureTime DateTime

  arrivalTime DateTime

  scheduleDate DateTime

  status ScheduleStatus @default(SCHEDULED)

  trips Trip[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([scheduleDate])
  @@map("schedules")
}

enum ScheduleStatus {
  SCHEDULED

  ACTIVE

  DELAYED

  COMPLETED

  CANCELLED
}

/**
 * ============================================================
 * TRIP
 * ============================================================
 */

model Trip {
  id Int @id @default(autoincrement())

  tripId String @unique @default(cuid())

  scheduleId Int

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  startTime DateTime

  endTime DateTime?

  status TripStatus @default(SCHEDULED)

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([status])
  @@map("trips")
}

enum TripStatus {
  SCHEDULED

  ACTIVE

  DELAYED

  COMPLETED

  CANCELLED
}

/**
 * ============================================================
 * FUEL LOG
 * ============================================================
 */

model FuelLog {
  id Int @id @default(autoincrement())

  fuelId String @unique @default(cuid())

  depotId Int

  depot Depot @relation(fields: [depotId], references: [id])

  vehicleId Int

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  date DateTime

  liters Float

  cost Float

  distanceCovered Float

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@index([vehicleId])
  @@index([date])
  @@map("fuel_logs")
}

/**
 * ============================================================
 * MAINTENANCE
 * ============================================================
 */

model MaintenanceRecord {
  id Int @id @default(autoincrement())

  maintenanceId String @unique @default(cuid())

  depotId Int

  depot Depot @relation(fields: [depotId], references: [id])

  vehicleId Int

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  maintenanceType MaintenanceType

  serviceDate DateTime

  nextServiceDate DateTime?

  cost Float

  remarks String?

  status MaintenanceStatus @default(SCHEDULED)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@index([vehicleId])
  @@index([serviceDate])
  @@map("maintenance_records")
}

enum MaintenanceType {
  SCHEDULED

  CORRECTIVE

  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED

  IN_PROGRESS

  COMPLETED

  CANCELLED
}

/**
 * ============================================================
 * AUDIT LOG
 * ============================================================
 */

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int

  user User @relation(fields: [userId], references: [id])

  action String

  entity String

  entityId String?

  description String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}
